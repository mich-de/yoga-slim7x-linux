+/*
+ * Speaker protection calibration: a firmware file of APM parameter frames
+ * {module iid, param id, size, 0, data padded to 8 bytes}, in the order the
+ * DSP expects them. It carries everything the RX and V/I modules and the
+ * V/I endpoint need (static tuning, R0/T0 of this unit, operation modes).
+ * One SET_CFG per frame: the DSP rejects some of them when packed together.
+ * A rejected frame is reported and does not stop the others.
+ */
+static int audioreach_sp_send_cal(struct q6apm_graph *graph)
+{
+	const struct firmware *fw;
+	int rc, sent = 0, bad = 0;
+	size_t off = 0;
+
+	rc = firmware_request_nowarn(&fw, sp_cal, graph->dev);
+	if (rc) {
+		dev_err(graph->dev, "speaker protection: no calibration %s (%d)\n", sp_cal, rc);
+		return rc;
 	}
 
