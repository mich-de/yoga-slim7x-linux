+		rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+		kfree(pkt);
+		if (rc) {
+			bad++;
+			dev_err(graph->dev, "speaker protection: frame %d iid 0x%x param 0x%08x size %u: %d\n",
+				sent, frame->module_instance_id, frame->param_id,
+				frame->param_size, rc);
+			if (rc == -ETIMEDOUT)
+				goto out;
+		}
+		sent++;
+		off += sz;
 	}
 
