-	cm_sz = APM_SP_VI_CH_MAP_CFG_PSIZE(num_channels * 2);
-	ex_sz = APM_SP_VI_EX_MODE_CFG_PSIZE;
-
-	payload_size = op_sz + cm_sz + ex_sz;
-
-	pkt = audioreach_alloc_apm_cmd_pkt(payload_size, APM_CMD_SET_CFG, 0);
