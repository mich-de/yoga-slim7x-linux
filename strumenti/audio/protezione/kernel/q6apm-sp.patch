+/*
+ * Debug read of a module parameter (e.g. speaker protection telemetry):
+ *   echo "<iid> <param id> <size>" > /sys/module/<module>/parameters/getcfg
+ * The reply is dumped in the kernel log.
+ */
+static int q6apm_getcfg_set(const char *val, const struct kernel_param *kp)
+{
+	struct apm_module_param_data *param_data;
+	struct q6apm *apm = g_apm;
+	int iid, pid, size, rc;
+	struct gpr_pkt *pkt;
+
+	if (!apm || sscanf(val, "%i %i %i", &iid, &pid, &size) != 3 ||
+	    size < 0 || size > APM_GETCFG_MAX)
+		return -EINVAL;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(APM_MODULE_PARAM_DATA_SIZE + ALIGN(size, 8),
+					   APM_CMD_GET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	param_data = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	param_data->module_instance_id = iid;
+	param_data->param_id = pid;
+	param_data->param_size = size;
+
+	rc = q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_CFG);
+	kfree(pkt);
+
+	return rc;
+}
+
+static const struct kernel_param_ops q6apm_getcfg_ops = {
+	.set = q6apm_getcfg_set,
+};
+module_param_cb(getcfg, &q6apm_getcfg_ops, NULL, 0200);
