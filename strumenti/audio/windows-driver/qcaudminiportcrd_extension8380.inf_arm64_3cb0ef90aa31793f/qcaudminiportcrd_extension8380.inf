[Extension_Device_CRD_Inst.Components]
AddComponent = ProxyAPO,,Apo_AddComponent_Proxy

[Apo_AddComponent_Proxy]
ComponentIDs = VEN_QCOM&DEV_APO_8380
Description = "Qualcomm Audio Proxy APO"

[Extension_Device.I.APO]
AddReg = APO.I.Association0.AddReg

;======================================================
; APO per-interface registry
;======================================================
[APO.I.Association0.AddReg]
; Instruct audio endpoint builder to set the CLSIDs for stream, mode, and endpoint APOs
; into the effects property store
HKR,FX\0,%PKEY_FX_ModeEffectClsid%,,%FX_MODE_CLSID%
HKR,FX\0,%PKEY_FX_EndpointEffectClsid%,,%FX_ENDPOINT_CLSID%

[Extension_Device_CRD_Inst.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, Extension_Device.I.APO

;
; Interfaces for speaker (external: Headset) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeakerHeadset%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeakerHeadset%, Extension_Device.I.APO

;
; Interfaces for microphone (external: Headset) capture endpoint 
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicHeadset%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicHeadset%, Extension_Device.I.APO

;
; Interfaces for microphone (internal) capture endpoint 
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicIn%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicIn%, Extension_Device.I.APO

;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, Extension_Device.I.APO

;
; Interfaces for ExternalDisplay (external) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologyExternalDisplay%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyExternalDisplay%, Extension_Device.I.APO

;
; Interfaces for Bluetooth HFP speaker (external) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologyBthHfpSpeaker%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyBthHfpSpeaker%, Extension_Device.I.APO

;
; Interfaces for Bluetooth HFP mic (external) capture endpoint 
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyBthHfpMic%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyBthHfpMic%, Extension_Device.I.APO

;
; Interfaces for Bluetooth A2DP HP speaker (external) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologyA2dp%, Extension_Device.I.APO
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyA2dp%, Extension_Device.I.APO

;======================================================
; COMMON
;======================================================
[Strings]

REG_BINARY			 = 0x00000001
REG_DWORD		     = 0x00010001
REG_MULTI_SZ		 = 0x00010000
REG_APPEND_MULTI_SZ  = 0x00010008
			
;Non-localizable

